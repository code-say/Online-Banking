@model RegisterViewModel
@{
    ViewData["Title"] = "Create your login";
}
<div class="narrow card">
    <p class="eyebrow">Step 1 of 2</p>
    <h1>Create your login</h1>
    <p class="muted">Next you'll apply for a savings or current account.</p>

    <form asp-action="Register" method="post" class="form" data-once novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" autocomplete="name" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" autocomplete="tel" placeholder="+91 98xxx xxxxx" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span class="hint">At least 8 characters, with letters and a number.</span>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
        </div>
        <button class="btn btn-primary btn-block" type="submit" data-busy="Creating…">Continue</button>
    </form>
    <p class="muted mt-16 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
</div>
