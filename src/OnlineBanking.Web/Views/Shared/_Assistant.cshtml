@* The in-app banking assistant. Rendered for signed-in customers when a chat model is configured. *@
@{
    var firstName = User.DisplayName().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
}
<button type="button" class="assistant-fab" id="assistant-open" aria-controls="assistant-panel" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 2.4 1.3 4.5 3.4 6L5 21l4.2-2.2c.9.2 1.8.3 2.8.3 5.5 0 10-3.6 10-8s-4.5-8-10-8Zm-4 9.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" /></svg>
    <span>Ask assistant</span>
</button>

<section class="assistant hidden" id="assistant-panel" role="dialog" aria-label="Banking assistant" data-name="@firstName"
         data-send="@Url.Action("Send", "Assistant", new { area = "" })" data-reset="@Url.Action("Reset", "Assistant", new { area = "" })"
         data-history="@Url.Action("History", "Assistant", new { area = "" })">
    <header class="assistant-head">
        <div>
            <strong>Banking Assistant</strong>
            <span class="assistant-sub">AI · can't send money without your PIN</span>
        </div>
        <div class="assistant-tools">
            <button type="button" class="icon-btn" id="assistant-reset" title="New conversation" aria-label="New conversation">↺</button>
            <button type="button" class="icon-btn" id="assistant-close" title="Close" aria-label="Close assistant">✕</button>
        </div>
    </header>

    <div class="assistant-log" id="assistant-log" aria-live="polite"></div>

    <div class="assistant-chips" id="assistant-chips">
        <button type="button" class="chip-btn">What's my total balance?</button>
        <button type="button" class="chip-btn">How much did I spend last month?</button>
        <button type="button" class="chip-btn">Show my last 5 transactions</button>
        <button type="button" class="chip-btn">Send ₹500 to 5010 0098 7654</button>
    </div>

    <form class="assistant-form" id="assistant-form" method="post" asp-area="" asp-controller="Assistant" asp-action="Send">
        <label for="assistant-input" class="skip">Message</label>
        <textarea id="assistant-input" rows="1" maxlength="600" placeholder="Ask about your money…" autocomplete="off"></textarea>
        <button type="submit" class="btn btn-primary btn-sm" id="assistant-send">Send</button>
    </form>
    <p class="assistant-foot">AI answers can be wrong. Never share your PIN or password, here or anywhere.</p>
</section>
